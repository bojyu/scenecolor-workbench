    { "angle": "right", "ranges": [[80, 100, true, true]], "direction": "right" },
    { "angle": "back_right", "ranges": [[100, 170, false, false]], "direction": "right" },
    { "angle": "back", "ranges": [[170, 190, true, true]], "direction": "center" },
    { "angle": "back_left", "ranges": [[190, 260, false, false]], "direction": "left" },
    { "angle": "left", "ranges": [[260, 280, true, true]], "direction": "left" },
    { "angle": "front_left", "ranges": [[280, 350, false, false]], "direction": "left" }
